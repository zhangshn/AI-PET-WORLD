    "latentChannels": 12,
    "latentDownsampleFactor": 4,
    "source": "current decoded RGB, four approved object masks and existing formal width contract"
  },
  "objectIdentityOrder": [
    "object_footprints",
    "object_tree",
    "object_rock",
    "object_vegetation"
  ],
  "compositionRule": {
    "oneIndependentParameterNamespacePerObjectClass": true,
    "perHeadInput": "decoded_rgb_plus_same_class_authoritative_mask_only",
    "outsideSameClassMaskContributionMustBeZero": true,
    "overlapRule": "normalize_sum_of_masked_rgb_proposals_by_exact_mask_sum_using_current_tensor_dtype_epsilon",
    "backgroundRule": "retain_frozen_autoencoder_decoded_rgb_where_object_mask_sum_is_zero",
    "freeBlendWeightsAllowed": false,
    "finalHarmonizerMayEraseObjectRgb": false
  },
  "frozenBoundaries": {
