{
  "schemaVersion": "ai-painter-capability-runtime-autonomy-contract-v3",
  "contractId": "ai-painter-capability-runtime-autonomy-contract-v3",
  "status": "policy_active_no_capability_release",
  "authorityBoundary": {
    "rootAuthority": "released_capability_identity",
    "normalOperationAuthority": "local_ai_pet_world_program",
    "ownerInNormalStateMachine": false,
    "perTaskOwnerAuthorizationRequired": false,
    "perStageOwnerAuthorizationRequired": false,
    "perCapabilityVersionOwnerAuthorizationRequired": false,
    "perCandidateOwnerReviewRequired": false,
    "ownerMayObservePauseOrEmergencyStop": true,
    "codexIsRequiredAtRuntime": false,
    "historicalPackagesMayAuthorizeNewWork": false
  },
  "capabilityReleaseVerification": {
    "trustedRegistryPath": "data/ai-painter/system-governance/ai-painter-capability-release-registry-v2.json",
    "trustedRegistrySchemaVersion": "ai-painter-capability-release-registry-v2",
    "releaseSchemaVersion": "ai-painter-capability-release-v2",
    "machineReleaseAdjudicationSchemaVersion": "ai-painter-machine-capability-release-adjudication-v1",
    "releaseStatusRequired": "released",
    "requiredBindingRoles": [
      "datasetRelease",
      "modelArtifact",
      "reviewContract",
      "runtimeInterfaceContract",
      "conditionContract"
    ],
    "readImmutableFilesAndRecomputeSha256": true,
    "callerSuppliedVerifiedBooleanTrusted": false,
    "uniqueRegistryWriterRequired": true,
    "machineSignatureRequiredForInternalTicket": true,
    "ticketSha256RecomputedAtConsumption": true,
    "persistentReplayLedgerRequired": true
  },
  "executionStates": [
    "package_materialized",
    "preflight",
    "executing",
    "validating",
    "reviewing",
    "adjudicating",
    "finalizing",
    "completed",
    "failed_closed",
    "blocked_policy_boundary"
  ],
  "terminalStates": [
    "completed",
    "failed_closed",
    "blocked_policy_boundary"
  ],
  "allowedTransitions": {
    "package_materialized": ["preflight", "failed_closed", "blocked_policy_boundary"],
    "preflight": ["preflight", "executing", "failed_closed", "blocked_policy_boundary"],
    "executing": ["executing", "validating", "failed_closed", "blocked_policy_boundary"],
    "validating": ["validating", "reviewing", "failed_closed", "blocked_policy_boundary"],
    "reviewing": ["reviewing", "adjudicating", "failed_closed", "blocked_policy_boundary"],
    "adjudicating": ["adjudicating", "finalizing", "failed_closed", "blocked_policy_boundary"],
    "finalizing": ["finalizing", "completed", "failed_closed", "blocked_policy_boundary"]
  },
  "releasedCapabilityInternalActions": [
    "preflight.verify",
    "formal_inference.start",
    "execution.observe",
    "validation.fixed_evidence",
    "review.machine",
    "adjudication.deterministic",
    "runtime_frame.create",
    "world.enter",
    "terminal.complete",
    "terminal.fail_closed",
    "policy_boundary.report",
    "governance.sync",
    "infrastructure.recover_bounded"
  ],
  "localCapabilityLifecycleActions": [
    "training.start_or_retry",
    "optimizer.create",
    "weights.modify",
    "checkpoint.select_or_promote",
    "model.implement_bounded_change",
    "loss.implement_bounded_change",
    "data_release.materialize",
    "review_contract.change_candidate",
    "program_lineage.change_candidate",
    "model_family.change_candidate",
    "capability_release.adjudicate",
    "capability_release.rollback"
  ],
  "policyBoundaryClasses": [
    "long_term_business_goal_change",
    "worldfacts_authority_change",
    "source_license_or_legal_boundary",
    "safety_limit_change",
    "audit_truthfulness_conflict",
    "unregistered_external_cost",
    "irreversible_destructive_action"
  ],
  "internalCapabilityTicketRequiredFields": [
    "ticketId",
    "issuerIdentity",
    "issuerKeyId",
    "capabilityReleaseIdentity",
    "capabilityReleasePath",
    "capabilityReleaseSha256",
    "trustedReleaseRegistryPath",
    "trustedReleaseRegistrySha256",
    "policyContractId",
    "policyContractPath",
    "policyContractSha256",
    "action",
    "currentState",
    "targetState",
    "inputEvidence",
    "programLineage",
    "outputNamespace",
    "attemptNumber",
    "nonce",
    "issuedAt",
    "expiresAt",
    "singleUse",
    "ticketSha256",
    "machineSignature"
  ],
  "decisionRules": {
    "engine": "deterministic_frozen_rule_engine",
    "requiresCompleteEvidence": true,
    "requiresExactlyOneMatchedOption": true,
    "ambiguousTargetState": "blocked_policy_boundary",
    "ambiguousFailureCode": "evidence_ambiguous",
    "freeFormModelDecisionAllowed": false,
    "ownerResponseWaitAllowed": false
  },
  "storage": {
    "executionState": ".runtime/ai-painter/capability-runtime-executions/<capabilityReleaseIdentity>/<executionId>/state.json",
    "internalCapability": ".runtime/ai-painter/capability-runtime-tickets/<capabilityReleaseIdentity>/<ticketId>/",
    "policyBoundaryReport": ".runtime/ai-painter/policy-boundary-reports/<reportId>/",
    "persistentReplayLedger": ".runtime/ai-painter/capability-runtime-ticket-ledger.sqlite",
    "mustUseProjectLogicalRelativePath": true,
    "mustCreateWithoutOverwrite": true,
    "mustIndexSqlite": true
  }
}
