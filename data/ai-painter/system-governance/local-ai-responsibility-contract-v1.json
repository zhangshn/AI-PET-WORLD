{
  "schemaVersion": "ai-painter-local-system-responsibility-contract-v1",
  "contractId": "ai-painter-local-system-responsibility-v1",
  "status": "active",
  "ownerRole": "project_owner",
  "systemOfRecord": {
    "authority": "local_ai_pet_world_program",
    "evidence": "local_immutable_files",
    "queryIndex": "local_sqlite_catalog",
    "chatIsFormalEvidence": false,
    "externalAgentMemoryIsFormalEvidence": false
  },
  "localSmallAiResponsibilities": [
    "read_current_world_facts_tasks_conditions_reviews_and_storage_evidence",
    "detect_gate_conflicts_and_distinguish_model_failure_from_reviewer_false_positive",
    "produce_a_plain_language_owner_action_request",
    "state_why_the_current_action_cannot_continue",
    "request_only_the_minimum_bounded_authorization",
    "declare_all_invariants_and_forbidden_side_effects",
    "persist_the_request_before_waiting_for_owner_input",
    "after_owner_authorization_execute_only_the_approved_scope",
    "rerun_required_checks_and_persist_the_result",
    "register_capacity_or_other_business_state_only_after_all_gates_pass"
  ],
  "ownerActionRequestContract": {
    "requiredContent": [
      "task_identity",
      "owner_visible_conclusion",
      "local_system_finding",
      "blocking_reason",
      "why_cannot_proceed",
      "minimum_requested_action",
      "invariants",
      "forbidden_actions",
      "evidence_paths",
      "owner_facing_message",
      "next_action_after_authorization"
    ],
    "statuses": [
      "waiting_owner_authorization",
      "waiting_owner_review",
      "owner_authorized_pending_execution",
      "resolved_owner_authorized",
      "resolved_owner_rejected",
      "cancelled_by_newer_authority"
    ],
    "mustBeStoredLocallyBeforeWaiting": true,
    "mustEmitLocalProgramEvent": true,
    "mustBeIndexedInLocalSqlite": true
  },
  "externalEmployeeBoundary": {
    "appliesTo": [
      "codex",
      "other_external_intelligent_execution_agents"
    ],
    "currentRole": "bounded_execution_and_verification_employee",
    "targetRole": "verification_employee_only",
    "allowedResponsibilities": [
      "execute_an_explicitly_assigned_bounded_task",
      "run_corresponding_checks",
      "report_evidence_back_to_the_local_system"
    ],
    "forbiddenAuthority": [
      "act_as_system_of_record",
      "replace_local_long_term_memory",
      "invent_world_facts_or_policy",
      "infer_owner_approval",
      "bypass_machine_or_owner_gates",
      "be_required_for_local_decision_explanations"
    ],
    "temporaryColdStartDependency": "Codex built-in image generation may remain a bounded cold-start RGB tool until the approved local model can replace it; this does not grant workflow or decision authority."
  },
  "migrationDirection": {
    "phase1": "local_system_records_all_decisions_requests_reviews_and_results_while_external_employee_may_execute_bounded_steps",
    "phase2": "local_system_orchestrates_authorized_work_and_external_employee_only_runs_specialized_checks",
    "phase3": "external_employee_is_optional_and_the_local_system_remains_operational_without_chat_history"
  }
}
