{
  "schemaVersion": "ai-painter-autonomous-package-decision-contract-v1",
  "contractId": "ai-painter-autonomous-package-decision-contract-v1",
  "status": "cpu_supported_inactive",
  "authorityBoundary": {
    "rootAuthority": "project_owner_signed_parent_package",
    "internalCapabilityIsOwnerAuthorization": false,
    "mayEscalateParentPrivilege": false,
    "historicalPackagesMayBeUpgraded": false,
    "codexIsRequiredAtRuntime": false
  },
  "states": [
    "parent_authorized_pending",
    "preflight",
    "executing",
    "validating",
    "reviewing",
    "adjudicating",
    "finalizing",
    "completed",
    "failed_closed",
    "waiting_owner_decision"
  ],
  "terminalStates": [
    "completed",
    "failed_closed",
    "waiting_owner_decision"
  ],
  "allowedTransitions": {
    "parent_authorized_pending": ["preflight", "failed_closed"],
    "preflight": ["preflight", "executing", "failed_closed", "waiting_owner_decision"],
    "executing": ["executing", "validating", "failed_closed", "waiting_owner_decision"],
    "validating": ["validating", "reviewing", "failed_closed", "waiting_owner_decision"],
    "reviewing": ["reviewing", "adjudicating", "failed_closed", "waiting_owner_decision"],
    "adjudicating": ["adjudicating", "finalizing", "failed_closed", "waiting_owner_decision"],
    "finalizing": ["finalizing", "completed", "failed_closed"]
  },
  "internalActionClasses": [
    "preflight.verify",
    "execution.observe",
    "validation.fixed_evidence",
    "review.machine",
    "adjudication.deterministic",
    "finalization.write",
    "terminal.complete",
    "terminal.fail_closed",
    "governance.sync",
    "infrastructure.recover_pre_risk",
    "owner.wait"
  ],
  "ownerOnlyActionClasses": [
    "gpu.start_unlisted",
    "training.start_unlisted",
    "training.retry_after_risk_boundary",
    "optimizer.create_unlisted",
    "weights.modify_unlisted",
    "checkpoint.read_or_initialize_unlisted",
    "checkpoint.promote",
    "model.change",
    "loss.change",
    "data.change",
    "split.change",
    "review_threshold.change",
    "checkpoint_selection.change",
    "program_lineage.change",
    "model_family.create",
    "business_route.change",
    "evidence_source.change",
    "formal_inference.start",
    "runtime_frame.create",
    "world.enter"
  ],
  "internalCapabilityTicketRequiredFields": [
    "ticketId",
    "parentPackageId",
    "parentPackageSha256",
    "policyContractId",
    "policyContractSha256",
    "action",
    "currentState",
    "targetState",
    "inputEvidence",
    "programLineage",
    "outputNamespace",
    "attemptNumber",
    "noPrivilegeEscalation",
    "singleUse",
    "status",
    "ticketSha256"
  ],
  "decisionRules": {
    "engine": "deterministic_frozen_rule_engine",
    "requiresCompleteEvidence": true,
    "requiresExactlyOneMatchedOption": true,
    "ambiguousTargetState": "waiting_owner_decision",
    "freeFormModelDecisionAllowed": false,
    "requiredEvidenceFields": [
      "decisionSetId",
      "ruleVersion",
      "evidenceReferences",
      "matchedOption",
      "rejectedOptions"
    ]
  },
  "infrastructureRecoveryBoundary": {
    "parentPackageMustDeclareMaximumAttempts": true,
    "programLineageMustRemainIdentical": true,
    "inputEvidenceMustRemainIdentical": true,
    "allowedOnlyBeforeRiskBoundary": true,
    "riskBoundaryFlags": [
      "gpuStarted",
      "optimizerCreated",
      "weightsModified",
      "trainingStarted"
    ]
  },
  "storage": {
    "executionState": ".runtime/ai-painter/autonomous-package-executions/<packageId>/state.json",
    "internalCapability": ".runtime/ai-painter/autonomous-package-internal-capabilities/<packageId>/<ticketId>/",
    "decisionRecord": ".runtime/ai-painter/autonomous-package-decision-records/<packageId>/<decisionId>/",
    "mustUseProjectLogicalRelativePath": true,
    "mustCreateWithoutOverwrite": true,
    "mustIndexSqlite": true
  },
  "activationGates": {
    "configurationActiveNow": false,
    "gpuNow": false,
    "optimizerNow": false,
    "backwardNow": false,
    "weightModificationNow": false,
    "smokeNow": false,
    "trainingNow": false,
    "formalInferenceNow": false,
    "runtimeFrameNow": false,
    "worldNow": false
  }
}
