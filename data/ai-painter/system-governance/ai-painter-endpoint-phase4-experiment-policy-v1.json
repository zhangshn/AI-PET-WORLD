{
  "schemaVersion": "ai-painter-endpoint-phase4-experiment-policy-v1",
  "scope": "one_isolated_endpoint_ab_v4_not_formal_training",
  "executionLimit": 1,
  "attemptPath": ".runtime/ai-painter/learning-capacity-experiments/endpoint-phase4-v1-attempt.json",
  "resolution": [256, 192],
  "allowedNewLoss": "target_residual_phase4_smoothed_rms_v1",
  "coefficient": 1,
  "epsilonSquared": 1e-12,
  "formula": "r=prediction-target; m[c,a,b]=mean_yx(r[0,c,4*y+a,4*x+b]); q=m-mean_ab(m); loss=sqrt(mean_cab(q*q)+1e-12)-1e-6",
  "tensorContract": "float32 NCHW [1,3,192,256], same device, finite; target detached in [0,1]; no masking or output postprocessing",
  "controlObjective": "full18 every update plus existing endpointRGB11 when epoch%4==3",
  "candidateObjective": "controlObjective plus coefficient*phase4Loss at the same endpoint only",
  "endpointAdditionsPerArm": 50,
  "phase4AdditionsCandidateOnly": 50,
  "optimizerStepsPerArm": 200,
  "totalOptimizerStepLimit": 400,
  "automaticRetries": 0,
  "reviewRule": "all_six_nine_metrics_no_selection_v1",
  "thresholdChangesAllowed": false,
  "modelArchitectureChangesAllowed": false,
  "originalDataChangesAllowed": false,
  "holdoutAccessAllowed": false,
  "formalQualificationAllowed": false,
  "externalRequestsAllowed": false,
  "cpuBehaviorTestsRequired": true,
  "currentCandidateNoUpdateGpuProbesRequired": true
}
