# AI-PET-WORLD internal world image model
# 正式视觉链只允许项目内部训练和推理，不配置第三方在线绘图 Provider。

# 内部模型完成前保持 false。
AI_PET_WORLD_IMAGE_MODEL_ENABLED=false

# 项目自研模型版本，例如 world-image-model-v0.1。
AI_PET_WORLD_IMAGE_MODEL_VERSION=

# 项目自研模型权重与 manifest 所在目录。
AI_PET_WORLD_IMAGE_MODEL_ASSET_DIR=

# 生成图片的本地输出目录。data/ 已被 git 忽略。
AI_PET_WORLD_IMAGE_OUTPUT_DIR=data/world-image-model/generated

# Owner通用写授权信任注册表。注册表只保存公钥；私钥不得进入项目、环境变量或Codex。
AI_PET_WORLD_OWNER_TRUST_REGISTRY_PATH=data/ai-painter/system-governance/project-owner-trust-registry-v1.json

# 部署时由Owner在项目外确认并固定的注册表SHA-256；缺失或不匹配时所有通用写入口失败关闭。
AI_PET_WORLD_OWNER_TRUST_REGISTRY_SHA256=

# 以下变量只在单次生产构建进程中注入，并必须与签名授权文件完全匹配；不得长期复用。
AI_PET_WORLD_OWNER_AUTHORIZATION_PATH=
AI_PET_WORLD_OWNER_AUTHORIZATION_SHA256=
AI_PET_WORLD_OWNER_COMMAND_REF=
AI_PET_WORLD_OWNER_AUTHORIZATION_SCOPE=
