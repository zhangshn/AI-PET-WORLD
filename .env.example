# AI-PET-WORLD local image model provider
# 当前文件作用：记录正式视觉链路接入真实 local image model 时需要的环境变量模板。

# 图像生成入口类型。
# 当前 MD 主线使用 local_model。
AI_PET_WORLD_IMAGE_PROVIDER=local_model

# 真实 local image model 的正式生成接口。
# 必须返回 imageUrl / imageFormat / width / height / license / originalityConfirmed。
# 不能指向主项目自己的 /api/local-image-model/generate。
# 不能返回假图、占位图、SVG、HTML、JSON 调试图或程序绘图结果。
AI_PET_WORLD_LOCAL_IMAGE_MODEL_ENDPOINT=http://localhost:7001/generate

# 真实 local image model 的健康检查接口。
AI_PET_WORLD_LOCAL_IMAGE_MODEL_HEALTH_ENDPOINT=http://localhost:7001/health

# 真实 local image model 的 dry-run 契约检查接口。
AI_PET_WORLD_LOCAL_IMAGE_MODEL_DRY_RUN_ENDPOINT=http://localhost:7001/dry-run

# 真实 local image model 输出图片的本地目录。
# 生成图不得上传仓库；data/ 已在 .gitignore 中忽略。
AI_PET_WORLD_LOCAL_IMAGE_OUTPUT_DIR=data/local-image-model/generated

# 真实 local image model 输出图片的公开访问地址。
# 图片返回给主项目时必须是 http/https/data:image，不允许 file:// 或本机路径。
AI_PET_WORLD_LOCAL_IMAGE_OUTPUT_PUBLIC_BASE_URL=http://localhost:7001

# 真实自研图像模型启用门禁。
# 当前没有真实推理 runner 前保持 false。
AI_PET_WORLD_REAL_IMAGE_MODEL_ENABLED=false

# 真实自研图像模型资产目录。
AI_PET_WORLD_REAL_IMAGE_MODEL_ASSET_DIR=

# 真实自研图像模型 manifest 文件。
AI_PET_WORLD_REAL_IMAGE_MODEL_MANIFEST=

# 真实自研图像模型授权类型：self_owned / cc0 / commercial_license。
AI_PET_WORLD_REAL_IMAGE_MODEL_LICENSE=self_owned

# 真实自研图像模型是否确认原创/授权链路。
AI_PET_WORLD_REAL_IMAGE_MODEL_ORIGINALITY_CONFIRMED=false